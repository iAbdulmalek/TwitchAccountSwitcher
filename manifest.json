{
  "manifest_version": 3,
  "name": "Twitch Account Switcher",
  "version": "1.0.0",
  "description": "Switch between your own Twitch accounts. Sessions are stored locally in your browser.",
  "minimum_chrome_version": "100",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitch Account Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
